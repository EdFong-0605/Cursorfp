# Firebase web app config (Firebase Console → Project settings → Your apps).
# Used for BOTH `npm start` and `npm run build` / production deploy.
# Auth: sign-in lasts for the browser tab/session (refresh keeps you in; closing the tab logs you out).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=lynkfiprod.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=lynkfiprod
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Optional: Cloud Functions region (defaults to us-central1 in clientfetch.js).
# REACT_APP_FIREBASE_FUNCTIONS_REGION=us-central1

# --- Local emulators only (do NOT set on production deploy) ---
# Put this in `.env.development.local` (not `.env`) so `npm run build` never bakes it in:
# REACT_APP_ENV=local
